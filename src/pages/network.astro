---
import Base from "../layouts/Base.astro";
import { shows, contestants, photos, seasonLabel, seasonYear, resultText } from "../lib/universe.mjs";

// Everything the explorer needs, built once at build time.
const graph = {
  shows: shows.map((s) => ({ id: s.id, name: s.name, color: s.color, network: s.network, years: s.years, kind: s.kind })),
  seasons: shows.flatMap((show) =>
    show.seasons.map((season) => ({
      id: season.id,
      show: show.id,
      name: seasonLabel(show, season),
      full: seasonLabel(show, season),
      aired: season.aired,
      year: seasonYear(season),
      upcoming: !!season.upcoming,
    }))
  ),
  people: contestants.map((c) => ({
    id: c.id,
    name: c.name,
    ko: c.ko ?? "",
    known: c.known ?? "",
    photo: photos[c.id]?.src ?? "",
    apps: c.apps.map(({ season, entry }) => ({
      season: season.id,
      result: resultText(entry, season),
      place: entry.place ?? null,
      won: entry.place === 1,
    })),
  })),
};

const years = graph.seasons.map((s) => s.year);
const firstYear = Math.min(...years), lastYear = Math.max(...years);

// Show filters grouped by kind of game.
const kindOrder = ["Strategy", "Team strategy", "Duel", "Deduction", "Social", "Indie web show", "Mystery and escape", "Quiz and puzzles", "Brain and physical", "Physical"];
const kinds = [...new Set(shows.map((s) => s.kind))].sort((a, b) => (kindOrder.indexOf(a) + 99) % 99 - (kindOrder.indexOf(b) + 99) % 99);

const tries = [
  { action: "tour", label: "▶ Take the tour" },
  { action: "circle:hong-jin-ho", label: "Hong Jin-ho's circle" },
  { action: "path:lee-se-dol:amotti", label: "Lee Se-dol to Amotti" },
  { action: "group:devils-plan-3", label: "Devil's Plan 3 cast" },
  { action: "center:hong-jin-ho", label: "Rings around Hong Jin-ho" },
  { action: "lanes", label: "Show lanes" },
  { action: "focus:jang-dong-min", label: "Jang Dong-min's titles" },
  { action: "timeline", label: "Watch it grow" },
];
---
<Base title="Network" description="Explore who played with whom across every Korean survival show: search players, trace connections, compare rivals and watch the universe grow.">
  <div class="net" id="net">
    <div class="net-canvas" id="graph" aria-label="3D network of players and the seasons they shared"></div>

    <div class="net-panel net-controls" id="controls">
      <div class="eyebrow">The network</div>
      <h1>Who played with whom</h1>

      <div class="search">
        <input id="find" type="search" placeholder="Find a player or show" aria-label="Find a player or show" autocomplete="off" />
        <ul class="suggest" id="find-list" role="listbox" hidden></ul>
      </div>

      <div class="try" aria-label="Try">
        {tries.map((t) => <button type="button" class="try-chip" data-action={t.action}>{t.label}</button>)}
      </div>

      <div class="active" id="active" hidden></div>

      <div class="timeline">
        <div class="label row"><span>Timeline</span><output id="year-out">{lastYear}</output></div>
        <div class="time-row">
          <button type="button" class="play" id="play" aria-label="Play the timeline">▶</button>
          <input type="range" id="year" min={firstYear} max={lastYear} step="1" value={lastYear} aria-label="Show seasons up to year" />
        </div>
      </div>

      <details class="more" id="more" open>
        <summary>Filters and tools</summary>

        <div class="label">Layout</div>
        <div class="seg" role="group" aria-label="Layout">
          <button type="button" data-layout="web" aria-pressed="true" title="Players pulled together by shared seasons">Web</button>
          <button type="button" data-layout="rings" aria-pressed="false" title="Legends at the center, one-season players outside">Rings</button>
          <button type="button" data-layout="flow" aria-pressed="false" title="Left to right by debut year">Flow</button>
        </div>
        <div class="seg sub" role="group" aria-label="Rings by" id="rings-by" hidden>
          <button type="button" data-rings="tier" aria-pressed="true">Tier</button>
          <button type="button" data-rings="seasons" aria-pressed="false">Seasons</button>
          <button type="button" data-rings="steps" aria-pressed="false">Steps</button>
        </div>
        <div class="seg sub" role="group" aria-label="Flow by" id="flow-by" hidden>
          <button type="button" data-flow="debut" aria-pressed="true">Debut</button>
          <button type="button" data-flow="lanes" aria-pressed="false">Show lanes</button>
          <button type="button" data-flow="spiral" aria-pressed="false">Spiral</button>
        </div>
        <p class="hint muted" id="layout-hint">Players pulled together by the seasons they shared.</p>

        <div class="label">Color by</div>
        <div class="selects">
          <select id="color-by" aria-label="Color players by">
            <option value="show">Main show</option>
            <option value="tier">Career tier</option>
            <option value="debut">Debut year</option>
            <option value="family">Hidden family</option>
          </select>
          <select id="size-by" aria-label="Size players by">
            <option value="connections">Size: connections</option>
            <option value="bridging">Size: bridging</option>
            <option value="titles">Size: titles</option>
            <option value="seasons">Size: seasons</option>
          </select>
        </div>
        <div class="color-key" id="color-key" hidden></div>

        <div class="label">View</div>
        <div class="seg" role="group" aria-label="View">
          <button type="button" data-view="players" aria-pressed="true">Players</button>
          <button type="button" data-view="seasons" aria-pressed="false">Seasons</button>
        </div>

        <div class="label">Who</div>
        <div class="seg" role="group" aria-label="Who to show">
          <button type="button" data-who="veterans" aria-pressed="true">Veterans</button>
          <button type="button" data-who="all" aria-pressed="false">Everyone</button>
        </div>

        <label class="check"><input type="checkbox" id="strong" checked /> Strong ties only (2+ seasons together)</label>
        <label class="check"><input type="checkbox" id="flat" /> Flat view (2D)</label>

        <div class="label">Connect two players</div>
        <div class="connect">
          <div class="search">
            <input id="from" type="search" placeholder="From" aria-label="Connect from" autocomplete="off" />
            <ul class="suggest" id="from-list" role="listbox" hidden></ul>
          </div>
          <div class="search">
            <input id="to" type="search" placeholder="To" aria-label="Connect to" autocomplete="off" />
            <ul class="suggest" id="to-list" role="listbox" hidden></ul>
          </div>
          <button type="button" class="go" id="go">Find the connection</button>
        </div>

        <div class="label row">Shows <button type="button" class="link" id="all-shows">All</button></div>
        {kinds.map((kind) => (
          <div class="kind">
            <div class="kind-name">{kind}</div>
            <div class="show-chips">
              {shows.filter((s) => s.kind === kind).map((s) => (
                <button type="button" class="show-chip" data-show={s.id} aria-pressed="true" style={`--c:${s.color}`}>{s.name}</button>
              ))}
            </div>
          </div>
        ))}
        <p class="hint muted">Players take the color of the show they played most. Tap a show to hide it, double-tap to show only it. Gold lines join players who met on more than one show.</p>

        <div class="tool-row">
          <button type="button" class="go ghost" id="list-open">Show as a list</button>
          <button type="button" class="go ghost" id="save-image">Save image</button>
        </div>
        <p class="hint muted">Drag to orbit, scroll or pinch to zoom. Hover a line to see what two players shared. Press / to search, Esc to clear.</p>
      </details>

      <details class="more" id="insights">
        <summary>Insights</summary>
        <div id="insights-body"></div>
      </details>
    </div>

    <aside class="net-panel net-info" id="info" hidden aria-live="polite">
      <button type="button" class="close" id="close" aria-label="Close">×</button>
      <div id="info-body"></div>
    </aside>

    <section class="net-list" id="list" hidden aria-label="List of connections">
      <div class="list-head">
        <h2 id="list-title">Connections</h2>
        <button type="button" class="close" id="list-close" aria-label="Close the list">×</button>
      </div>
      <div id="list-body"></div>
    </section>

    <div class="net-count" id="count" aria-live="polite"></div>

    <section class="tour" id="tour" hidden aria-live="polite" aria-label="Guided tour">
      <div class="tour-bar"><span id="tour-bar"></span></div>
      <div class="tour-head">
        <span class="eyebrow">Guided tour · <span id="tour-step"></span></span>
        <button type="button" class="tour-x" id="tour-exit" aria-label="End the tour">×</button>
      </div>
      <h2 id="tour-title"></h2>
      <p id="tour-text"></p>
      <div class="tour-nav">
        <button type="button" class="go ghost" id="tour-prev">Back</button>
        <button type="button" class="tour-auto" id="tour-auto" aria-pressed="true" title="Advance automatically">Auto</button>
        <button type="button" class="go" id="tour-next">Next</button>
      </div>
    </section>

    <div class="net-legend" id="legend" aria-label="Legend">
      <div><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="7" cy="12" r="3" fill="currentColor"/><circle cx="17" cy="12" r="6" fill="currentColor"/></svg>Size: how many people they played with</div>
      <div><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="5" fill="currentColor"/><circle cx="12" cy="12" r="9" fill="none" stroke="var(--gold)" stroke-width="2"/></svg>Gold ring: champion</div>
      <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 16 Q12 4 22 16" fill="none" stroke="currentColor" stroke-width="3"/></svg>Line: seasons together (thicker, brighter: more)</div>
      <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 16 Q12 4 22 16" fill="none" stroke="var(--gold)" stroke-width="2"/></svg>Gold line: met on more than one show</div>
      <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 16 Q12 4 22 16" fill="none" stroke="currentColor" stroke-width="1" opacity=".4"/><circle cx="12" cy="10" r="2.5" fill="currentColor"/></svg>Moving light: from the earlier debut to the later</div>
    </div>
  </div>

  <script type="application/json" id="graph-data" set:html={JSON.stringify(graph)} />
  <script>
    import "../scripts/network.js";
  </script>
</Base>

<style>
  .net { position: relative; height: calc(100dvh - 61px); overflow: hidden; }
  .net-canvas { position: absolute; inset: 0; }
  /* On wide screens the graph starts right of the controls, so nothing hides behind them. */
  @media (min-width: 761px) { .net-canvas { left: 342px; } }
  :global(body:has(.net) .site-foot) { display: none; }

  .net-panel {
    position: absolute; z-index: 2;
    background: color-mix(in srgb, var(--card) 90%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line); border-radius: var(--radius);
    padding: 16px;
  }
  .net-controls { top: 16px; left: 16px; width: 310px; max-height: calc(100% - 32px); overflow: auto; }
  .net-controls h1 { font-size: 22px; margin: 6px 0 12px; }
  .label { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 14px 0 6px; }
  .label.row { display: flex; justify-content: space-between; align-items: center; }
  .label output { font: 700 15px var(--display); color: var(--ink); letter-spacing: 0; }
  .seg { display: flex; background: var(--bg-2); border-radius: 10px; padding: 3px; }
  .seg button, .try-chip, .show-chip, .play, .go {
    user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;
  }
  .seg button {
    flex: 1; font: 600 14px var(--sans); color: var(--muted); background: none;
    border: 0; border-radius: 8px; padding: 7px 8px; cursor: pointer;
  }
  .seg button[aria-pressed="true"] { background: var(--card); color: var(--ink); box-shadow: 0 1px 3px rgb(0 0 0 / .25); }

  .search { position: relative; }
  .search input {
    width: 100%; font: inherit; font-size: 15px; color: var(--ink); background: var(--bg-2);
    border: 1px solid var(--line); border-radius: 10px; padding: 9px 11px;
  }
  .search input:focus { outline: 2px solid color-mix(in srgb, var(--accent) 60%, transparent); outline-offset: 0; }
  .suggest {
    position: absolute; z-index: 5; left: 0; right: 0; top: calc(100% + 4px);
    list-style: none; margin: 0; padding: 4px; max-height: 300px; overflow: auto;
    background: var(--card); border: 1px solid var(--line); border-radius: 10px;
    box-shadow: 0 10px 30px rgb(0 0 0 / .35);
  }
  :global(.suggest li) { display: flex; align-items: center; gap: 8px; padding: 7px 8px; border-radius: 7px; cursor: pointer; font-size: 14px; }
  :global(.suggest li[aria-selected="true"]), :global(.suggest li:hover) { background: var(--bg-2); }
  :global(.suggest .dot) { width: 9px; height: 9px; border-radius: 50%; flex: none; }
  :global(.suggest .meta) { margin-left: auto; color: var(--muted); font-size: 12px; text-align: right; }

  .try { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 10px; }
  .try-chip {
    font: 600 12px var(--sans); color: var(--ink); cursor: pointer;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line));
    border-radius: 999px; padding: 4px 9px;
  }

  .active { margin-top: 10px; display: grid; gap: 6px; }
  :global(.active .tag) {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    font-size: 13px; padding: 6px 8px 6px 10px; border-radius: 8px;
    background: color-mix(in srgb, var(--gold) 16%, transparent); color: var(--ink);
  }
  :global(.active .tag button) { background: none; border: 0; color: var(--muted); font-size: 18px; line-height: 1; cursor: pointer; padding: 0 2px; }

  .time-row { display: flex; align-items: center; gap: 8px; }
  .time-row input { flex: 1; accent-color: var(--accent); }
  .play {
    width: 34px; height: 34px; flex: none; border-radius: 50%; border: 1px solid var(--line);
    background: var(--bg-2); color: var(--ink); cursor: pointer; font-size: 13px;
  }

  .more { margin-top: 14px; }
  .more summary { cursor: pointer; font-weight: 650; font-size: 14px; color: var(--muted); list-style: none; }
  .more summary::-webkit-details-marker { display: none; }
  .more summary::before { content: "▸ "; }
  .more[open] summary::before { content: "▾ "; }

  .connect { display: grid; gap: 6px; }
  .go, :global(.net-info .act) {
    font: 650 14px var(--sans); color: #fff; background: var(--accent);
    border: 0; border-radius: 9px; padding: 9px 12px; cursor: pointer;
  }
  .go.ghost { background: var(--bg-2); color: var(--ink); width: 100%; margin-top: 14px; }
  .link { background: none; border: 0; color: var(--accent); font: 600 12px var(--sans); cursor: pointer; text-transform: none; letter-spacing: 0; }
  .kind { margin-bottom: 8px; }
  .kind-name { font-size: 11px; color: var(--muted); margin-bottom: 4px; }
  .show-chips { display: flex; flex-wrap: wrap; gap: 5px; }
  .show-chip {
    font: 600 12px var(--sans); padding: 4px 9px 4px 7px; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--line); background: transparent; color: var(--muted);
    display: inline-flex; align-items: center; gap: 6px;
  }
  .show-chip::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--c); opacity: .35; }
  .show-chip[aria-pressed="true"] { color: var(--ink); background: color-mix(in srgb, var(--c) 14%, transparent); border-color: color-mix(in srgb, var(--c) 45%, var(--line)); }
  .show-chip[aria-pressed="true"]::before { opacity: 1; }
  .check { display: flex; align-items: center; gap: 8px; margin-top: 12px; font-size: 14px; color: var(--muted); }
  .hint { font-size: 12px; margin: 8px 0 0; }

  :global(#insights-body h4) { font-size: 13px; margin: 14px 0 6px; font-family: var(--sans); }
  :global(#insights-body p) { font-size: 13px; color: var(--muted); margin: 0 0 6px; }
  :global(#insights-body ol) { margin: 0; padding-left: 18px; display: grid; gap: 3px; font-size: 13px; }
  :global(#insights-body .row-btn) { background: none; border: 0; padding: 0; color: var(--ink); font: inherit; cursor: pointer; text-align: left; }
  :global(#insights-body .row-btn:hover) { color: var(--accent); }
  :global(#insights-body .n) { color: var(--muted); }
  :global(#insights-body .dist) { display: flex; gap: 4px; align-items: flex-end; height: 56px; margin: 6px 0; }
  :global(#insights-body .bar) { flex: 1; background: var(--accent); border-radius: 3px 3px 0 0; min-height: 2px; position: relative; }
  :global(#insights-body .bar span) { position: absolute; bottom: -18px; left: 0; right: 0; text-align: center; font-size: 11px; color: var(--muted); }
  :global(#insights-body .dist-gap) { height: 16px; }

  .net-info { top: 16px; right: 16px; width: 340px; max-height: calc(100% - 32px); overflow: auto; }
  .close { position: absolute; top: 8px; right: 10px; background: none; border: 0; color: var(--muted); font-size: 26px; line-height: 1; cursor: pointer; }
  :global(.net-info h2) { font-size: 22px; margin: 4px 24px 2px 0; }
  :global(.net-info h3) { font-size: 13px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin: 16px 0 6px; font-family: var(--sans); }
  :global(.net-info .ko) { color: var(--muted); }
  :global(.net-info .pic) { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; object-position: 50% 25%; display: block; margin-bottom: 8px; }
  :global(.net-info .stat) { color: var(--muted); font-size: 14px; margin-top: 6px; }
  :global(.net-info .score) { font: 700 18px var(--display); margin-top: 8px; }
  :global(.net-info .score .gold) { color: var(--gold); }
  :global(.net-info .acts) { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  :global(.net-info .act.ghost) { background: var(--bg-2); color: var(--ink); }
  :global(.net-info a.act) { text-decoration: none; display: inline-block; }
  :global(.net-info ul) { list-style: none; padding: 0; margin: 0; display: grid; gap: 5px; }
  :global(.net-info .rec li) { display: flex; justify-content: space-between; gap: 10px; font-size: 13px; border-left: 3px solid var(--c); padding-left: 8px; }
  :global(.net-info .rec .r) { color: var(--muted); text-align: right; flex: none; max-width: 48%; }
  :global(.net-info .rec .r.won) { color: var(--gold); font-weight: 600; }
  :global(.net-info .mates) { display: flex; flex-wrap: wrap; gap: 5px; }
  :global(.net-info .mate) {
    font: 500 13px var(--sans); color: var(--ink); background: var(--bg-2); border: 1px solid var(--line);
    border-radius: 999px; padding: 4px 9px; cursor: pointer; display: inline-flex; gap: 5px; align-items: center;
  }
  :global(.net-info .mate b) { color: var(--gold); font-weight: 700; }
  :global(.net-info .mate.cross) { border-color: color-mix(in srgb, var(--gold) 50%, var(--line)); }
  :global(.net-info .hop) { display: grid; gap: 4px; padding: 8px 0; border-bottom: 1px dashed var(--line); }
  :global(.net-info .hop:last-child) { border-bottom: 0; }
  :global(.net-info .hop) { font-size: 14px; }
  :global(.net-info .hop .who) { font-weight: 650; }
  :global(.net-info .hop .better) { color: var(--ink); font-weight: 650; }
  :global(.net-info .chip) { margin: 0 4px 4px 0; }
  :global(.net-info .muted) { color: var(--muted); }

  .net-list {
    position: absolute; z-index: 3; inset: 16px 16px 16px 342px;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
    display: flex; flex-direction: column; overflow: hidden;
  }
  .list-head { display: flex; justify-content: space-between; align-items: center; padding: 14px 16px; border-bottom: 1px solid var(--line); position: relative; }
  .list-head h2 { font-size: 18px; }
  #list-body { overflow: auto; padding: 0 16px 16px; }
  :global(.net-list table) { width: 100%; border-collapse: collapse; font-size: 14px; }
  :global(.net-list th) { text-align: left; font-size: 12px; color: var(--muted); font-weight: 600; padding: 10px 6px; position: sticky; top: 0; background: var(--card); cursor: pointer; }
  :global(.net-list td) { padding: 8px 6px; border-top: 1px solid var(--line); vertical-align: top; }
  :global(.net-list tr.pick) { cursor: pointer; }
  :global(.net-list tr.pick:hover td) { background: var(--bg-2); }
  :global(.net-list .chip) { margin: 0 4px 4px 0; }
  :global(.net-list .note) { color: var(--muted); font-size: 13px; padding: 10px 0; }

  .seg.sub { margin-top: 6px; background: transparent; border: 1px solid var(--line); }
  .seg.sub button { font-size: 13px; padding: 5px 6px; }
  .seg.sub[hidden] { display: none; }
  .net-list[hidden], .active[hidden], .net-info[hidden], .tour[hidden], .color-key[hidden] { display: none; }

  .selects { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .selects select {
    font: 500 13px var(--sans); color: var(--ink); background: var(--bg-2);
    border: 1px solid var(--line); border-radius: 9px; padding: 7px 8px; min-width: 0;
  }
  .color-key { display: flex; flex-wrap: wrap; gap: 4px 10px; margin-top: 8px; }
  :global(.key-item) { display: inline-flex; align-items: center; gap: 5px; font: 500 12px var(--sans); color: var(--muted); background: none; border: 0; padding: 0; cursor: default; }
  :global(button.key-item) { cursor: pointer; }
  :global(button.key-item:hover) { color: var(--ink); }
  :global(.key-item span) { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
  .tool-row { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 14px; }
  .tool-row .go.ghost { margin-top: 0; }

  .tour {
    position: absolute; z-index: 4; left: calc(50% + 171px); bottom: 24px; transform: translateX(-50%);
    width: min(560px, calc(100% - 380px)); padding: 18px 20px 16px; border-radius: 16px;
    background: color-mix(in srgb, var(--card) 92%, transparent); backdrop-filter: blur(14px);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line));
    box-shadow: 0 18px 50px rgb(0 0 0 / .45);
    animation: rise .5s ease;
  }
  @keyframes rise { from { opacity: 0; transform: translate(-50%, 16px); } to { opacity: 1; transform: translate(-50%, 0); } }
  .tour-bar { height: 3px; background: var(--bg-2); border-radius: 3px; overflow: hidden; margin-bottom: 12px; }
  .tour-bar span { display: block; height: 100%; width: 0; background: var(--accent); transition: width .6s ease; }
  .tour-head { display: flex; justify-content: space-between; align-items: center; }
