---
import Avatar from "./Avatar.astro";
import { people } from "../lib/universe.mjs";

interface Props {
  id: string;
  sub?: string;
  color: string;
  won?: boolean;
}
const { id, sub, color, won = false } = Astro.props;
const p = people[id];
---
<a class:list={["card person", { won }]} href={`/contestants/${id}/`} style={`--show:${color}`}>
  <Avatar id={id} color={color} won={won} />
  <span class="who">
    <span class="name">{p.name}</span>
    {sub && <span class="sub">{sub}</span>}
  </span>
</a>
