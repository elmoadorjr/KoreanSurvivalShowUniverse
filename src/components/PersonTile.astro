---
import { people, initials } from "../lib/universe.mjs";

interface Props {
  id: string;
  sub?: string;
  color: string;
  won?: boolean;
}
const { id, sub, color, won = false } = Astro.props;
const p = people[id];
---
<a class:list={["card person", { won }]} href={`/contestants/${id}/`} style={`--show:${color}`}>
  <span class="avatar" aria-hidden="true">{initials(p.name)}{won && <span class="crown">👑</span>}</span>
  <span class="who">
    <span class="name">{p.name}</span>
    {sub && <span class="sub">{sub}</span>}
  </span>
</a>
