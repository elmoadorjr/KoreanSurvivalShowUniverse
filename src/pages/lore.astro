---
import Base from "../layouts/Base.astro";
import Avatar from "../components/Avatar.astro";
import { people, shows, seasonLabel, seasonYear, contestants } from "../lib/universe.mjs";
import { eras, moments, bonds, nicknames, architects } from "../lib/lore.mjs";

const showById = Object.fromEntries(shows.map((s) => [s.id, s]));
const colorOf = (id) => contestants.find((c) => c.id === id)?.shows[0]?.color ?? "var(--accent)";
const plain = (id) => people[id].name.replace(/\s*\(.*\)/, "");

// Each era with the shows that began in it and its moments.
const debut = (show) => Math.min(...show.seasons.map(seasonYear));
const river = eras.map((e) => ({
  ...e,
  shows: shows.filter((s) => debut(s) >= e.years[0] && debut(s) <= e.years[1]).sort((a, b) => debut(a) - debut(b)),
  moments: moments.filter((m) => m.year >= e.years[0] && m.year <= e.years[1]),
}));
const span = (e) => (e.years[0] === e.years[1] ? `${e.years[0]}` : `${e.years[0]} to ${e.years[1]}`);
---
<Base title="Lore" description="The lore of the Korean survival universe: its eras, legendary moments, alliances, feuds, nicknames and the people who built the games.">
  <div class="lore">
    <section class="lore-hero">
      <div class="wrap">
        <div class="eyebrow">The lore</div>
        <h1>Thirteen years of alliances, betrayals and comebacks.</h1>
        <p class="lede">From a room of thirteen players in 2013 to sixteen legends in one house in 2026: the eras, the moments fans still argue about, the partnerships and feuds that carried from show to show, and the two people who built the games.</p>
      </div>
    </section>

    <div class="wrap">
      <section>
        <div class="section-head"><h2>The eras</h2></div>
        <ol class="river">
          {river.map((e, i) => (
            <li class="era" style={`--i:${i}`}>
              <a href={`#era-${e.id}`} class="era-card">
                <span class="era-years">{span(e)}</span>
                <h3>{e.name}</h3>
                <p>{e.text}</p>
                <span class="era-shows">
                  {e.shows.map((s) => <span class="dot" style={`--show:${s.color}`} title={s.name}></span>)}
                </span>
                <span class="muted small">{e.shows.length} new show{e.shows.length === 1 ? "" : "s"} · {e.moments.length} moment{e.moments.length === 1 ? "" : "s"}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section>
        <div class="section-head"><h2>Legendary moments</h2></div>
        <div class="moments">
          {river.map((e) => e.moments.length > 0 && (
            <div class="era-block" id={`era-${e.id}`}>
              <div class="era-mark"><span>{span(e)}</span><b>{e.name}</b></div>
              <ol class="line">
                {e.moments.map((m) => (
                  <li class="moment" id={m.id} style={`--show:${m.show?.color ?? "var(--gold)"}`}>
                    <div class="when">
                      <b>{m.year}</b>
                      {m.show && <a href={`/shows/${m.show.id}/#${m.season.id}`}>{seasonLabel(m.show, m.season)}</a>}
                    </div>
                    <h3>{m.title}</h3>
                    <p>{m.text}</p>
                    <div class="who">
                      {m.people.map((id) => (
                        <a class="face" href={`/contestants/${id}/`} title={people[id].name}>
                          <Avatar id={id} color={colorOf(id)} />
                          <span>{plain(id)}</span>
                        </a>
                      ))}
                      {m.source && <a class="src" href={m.source} rel="noopener">Source</a>}
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </section>

      <section>
        <div class="section-head"><h2>Alliances, rivalries and feuds</h2><a href="/network/?layout=insights&lens=families">See the families</a></div>
        <div class="bonds">
          {bonds.map((b) => (
            <div class="card bond">
              <span class="chip">{b.kind}</span>
              <div class="stack">
                {b.people.map((id) => <a href={`/contestants/${id}/`} title={people[id].name}><Avatar id={id} color={colorOf(id)} /></a>)}
              </div>
              <h3>{b.name}</h3>
              <p class="muted small names">{b.people.map(plain).join(" · ")}</p>
              <p>{b.text}</p>
              {(b.together.length > 0 || b.record) && (
                <p class="muted small">
                  {b.together.length > 0 && `${b.together.length} season${b.together.length === 1 ? "" : "s"} together`}
                  {b.record && ` · ${b.record}`}
                </p>
              )}
              {b.together.length > 0 && (
                <div class="chips">
                  {b.together.map((t) => <a class="chip" style={`--show:${t.show.color}`} href={`/shows/${t.show.id}/#${t.season.id}`}>{seasonLabel(t.show, t.season)}</a>)}
                </div>
              )}
            </div>
          ))}
        </div>
      </section>

      <section>
        <div class="section-head"><h2>Nicknames and running jokes</h2></div>
        <ul class="nicks">
          {nicknames.map((n) => (
            <li class="card nick">
              <a href={`/contestants/${n.person}/`}><Avatar id={n.person} color={colorOf(n.person)} /></a>
              <div>
                <div class="nick-names">{n.names.map((x) => <span>"{x}"</span>)}</div>
                <a class="nick-who" href={`/contestants/${n.person}/`}>{people[n.person].name}</a>
                <p>{n.text}{n.source && <> <a class="src" href={n.source} rel="noopener">Source</a></>}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <div class="section-head"><h2>The architects</h2></div>
        <div class="bonds">
          {architects.map((a) => (
            <div class="card bond">
              <span class="chip">{a.role}</span>
              <h3>{a.name} <span class="muted ko" lang="ko">{a.ko}</span></h3>
              <p>{a.text}{a.source && <> <a class="src" href={a.source} rel="noopener">Source</a></>}</p>
              <div class="chips">
                {a.shows.map((id) => <a class="chip" style={`--show:${showById[id].color}`} href={`/shows/${id}/`}>{showById[id].name}</a>)}
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>
</Base>

<style>
  .lore-hero {
    padding: 56px 0 28px; border-bottom: 1px solid var(--line);
    background: radial-gradient(ellipse at 20% 0%, color-mix(in srgb, var(--gold) 22%, transparent), transparent 60%);
  }
  .lore-hero h1 { margin: 12px 0 14px; max-width: 820px; }
  .small { font-size: 13px; }

  /* The eras: a river of five cards joined by one line. */
  .river { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(5, minmax(0, 1fr)); position: relative; }
  .river::before { content: ""; position: absolute; left: 0; right: 0; top: 22px; height: 2px; background: linear-gradient(90deg, var(--accent), var(--gold)); opacity: .5; }
  .era { position: relative; padding-top: 34px; }
  .era::before { content: ""; position: absolute; top: 15px; left: 14px; width: 16px; height: 16px; border-radius: 50%; background: var(--bg); border: 3px solid color-mix(in srgb, var(--accent) calc(100% - var(--i) * 20%), var(--gold)); }
  .era-card { display: flex; flex-direction: column; gap: 6px; height: 100%; text-decoration: none; color: inherit; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px; }
  .era-card:hover { border-color: var(--accent); }
  .era-card h3 { font-size: 17px; margin: 0; }
  .era-card p { margin: 0; font-size: 14px; color: var(--muted); flex: 1; }
  .era-years { font: 700 13px var(--display); color: var(--gold); }
  .era-shows { display: flex; flex-wrap: wrap; gap: 4px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--show); }

  /* Moments: a timeline line with a dot in each show's color. */
  .era-block { margin-bottom: 18px; }
  .era-mark { display: flex; gap: 10px; align-items: baseline; margin: 18px 0 8px; }
  .era-mark span { font: 700 13px var(--display); color: var(--gold); }
  .line { list-style: none; margin: 0; padding: 0 0 0 22px; border-left: 2px solid var(--line); display: grid; gap: 14px; }
  .moment { position: relative; background: var(--card); border: 1px solid var(--line); border-left: 3px solid var(--show); border-radius: var(--radius); padding: 14px 16px; }
  .moment::before { content: ""; position: absolute; left: -31px; top: 18px; width: 14px; height: 14px; border-radius: 50%; background: var(--show); box-shadow: 0 0 0 4px var(--bg); }
  .moment h3 { font-size: 18px; margin: 4px 0 6px; }
  .moment p { margin: 0 0 10px; font-size: 15px; }
  .when { display: flex; gap: 10px; flex-wrap: wrap; align-items: baseline; font-size: 13px; }
  .when b { font: 700 14px var(--display); color: var(--gold); }
  .when a { color: var(--muted); }
  .who { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; }
  .face { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; color: var(--ink); font-size: 13px; font-weight: 600; }
  .face :global(.avatar) { width: 28px; height: 28px; font-size: 11px; }
  .src { font-size: 12px; color: var(--muted); }

  .bonds { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .bond { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .bond h3 { font-size: 18px; margin: 0; }
  .bond p { margin: 0; font-size: 15px; }
  .bond .names { margin-top: -4px; }
  .stack { display: flex; }
  .stack a { margin-right: -10px; text-decoration: none; }
  .stack :global(.avatar) { box-shadow: 0 0 0 3px var(--card); }
  .ko { font-size: 14px; font-weight: 500; }

  .nicks { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }
  .nick { display: flex; gap: 12px; align-items: flex-start; }
  .nick a { text-decoration: none; }
  .nick-names { display: flex; flex-wrap: wrap; gap: 6px; font: 700 16px var(--display); color: var(--gold); }
  .nick-who { font-size: 13px; color: var(--muted); }
  .nick p { margin: 6px 0 0; font-size: 14px; }

  @media (max-width: 900px) {
    .river { grid-template-columns: 1fr; gap: 10px; padding-left: 24px; }
    .river::before { left: 7px; right: auto; top: 0; bottom: 0; width: 2px; height: auto; background: linear-gradient(180deg, var(--accent), var(--gold)); }
    .era { padding-top: 0; }
    .era::before { left: -24px; top: 16px; }
  }
</style>
