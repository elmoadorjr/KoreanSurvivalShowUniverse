---
import Base from "../layouts/Base.astro";
import ShowCard from "../components/ShowCard.astro";
import PersonTile from "../components/PersonTile.astro";
import { shows, contestants, crossovers, champions, seasonLabel } from "../lib/universe.mjs";

const seasons = shows.flatMap((s) => s.seasons);
---
<Base title="Survival Universe">
  <div class="wrap">
    <section class="hero">
      <div class="eyebrow">The Korean survival show fan site</div>
      <h1>Every game, every player, every comeback.</h1>
      <p class="lede">From The Genius to The Devil's Plan, from The Bloody Game and The Time Hotel to indie web shows like Money Game and Four Wishes. Browse every season's cast and follow players as they cross from show to show.</p>
      <div class="stats">
        <div><b>{shows.length}</b><span>shows</span></div>
        <div><b>{seasons.length}</b><span>seasons</span></div>
        <div><b>{contestants.length}</b><span>contestant profiles</span></div>
        <div><b>{crossovers.length}</b><span>repeat players</span></div>
      </div>
    </section>

    <section>
      <div class="section-head"><h2>The shows</h2><a href="/shows/">All shows</a></div>
      <div class="grid">
        {shows.map((show) => <ShowCard show={show} />)}
      </div>
    </section>

    <section>
      <div class="section-head"><h2>The crossover players</h2><a href="/network/">See the network</a></div>
      <p class="muted" style="margin-top:-8px">The universe part: people who came back for another season, or another show entirely.</p>
      <div class="grid people">
        {crossovers.slice(0, 12).map((c) => (
          <PersonTile id={c.id} color={c.shows[0].color} sub={`${c.apps.length} seasons · ${c.shows.map((s) => s.name).join(", ")}`} />
        ))}
      </div>
    </section>

    <section>
      <div class="section-head"><h2>Hall of champions</h2></div>
      <div class="grid people">
        {champions.map(({ show, season, entry, others }) => (
          <PersonTile id={entry.person} color={show.color} won sub={`${seasonLabel(show, season)}${others ? ` (+${others} shared)` : ""}`} />
        ))}
      </div>
    </section>
  </div>
</Base>
