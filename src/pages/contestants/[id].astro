---
import Base from "../../layouts/Base.astro";
import PersonTile from "../../components/PersonTile.astro";
import Avatar from "../../components/Avatar.astro";
import { contestants, photos, resultText, seasonLabel, seasonNetwork, recordBio, headToHeadText, people } from "../../lib/universe.mjs";
import { loreForPerson } from "../../lib/lore.mjs";

export function getStaticPaths() {
  return contestants.map((c) => ({ params: { id: c.id }, props: { c } }));
}
const { c } = Astro.props;
const color = c.shows[0].color;
const wins = c.apps.filter((a) => a.entry.place === 1).length;

// Players who shared at least one season, most shared seasons first.
const shared = new Map();
for (const { season } of c.apps) {
  for (const e of season.cast) {
    if (e.person !== c.id) shared.set(e.person, (shared.get(e.person) ?? 0) + 1);
  }
}
const rivals = [...shared.entries()]
  .filter(([, n]) => n > 1)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8);
const rivalColor = (id) => contestants.find((x) => x.id === id).shows[0].color;
const lore = loreForPerson(c.id);
const others = (ids) => ids.filter((id) => id !== c.id).map((id) => people[id].name.replace(/\s*\(.*\)/, ""));
---
<Base title={c.name} description={c.bio ?? recordBio(c)}>
  <div class="wrap">
    <a class="back" href="/contestants/" style="margin-top:20px">All contestants</a>
    <div class="profile">
      <Avatar id={c.id} color={color} won={wins > 0} big />
      <div>
        <h1>{c.name}</h1>
        {c.ko && <div class="ko" lang="ko">{c.ko}</div>}
        {c.known && <div class="known">{c.known}</div>}
        <div class="chips" style="margin-top:12px">
          {c.shows.map((s) => <a class="chip" href={`/shows/${s.id}/`} style={`--show:${s.color}`}>{s.name}</a>)}
          {wins > 0 && <span class="chip gold">{wins === 1 ? "Champion" : `${wins}x champion`}</span>}
        </div>
        <a class="back" href={`/network/?focus=${c.id}`}>See {c.apps.length > 1 ? "their connections" : "them"} in the network</a>
      </div>
    </div>

    <section style="padding-top:8px">
      <p class="bio">{c.bio ?? recordBio(c)}</p>
      {photos[c.id] && (
        <p class="credit">Photo: {photos[c.id].credit}, <a href={photos[c.id].source} rel="noopener">{photos[c.id].license}</a>, via Wikimedia Commons</p>
      )}
    </section>

    {(lore.moments.length > 0 || lore.bonds.length > 0 || lore.nicknames.length > 0) && (
      <section>
        <div class="section-head"><h2>In the lore</h2><a href="/lore/">All the lore</a></div>
        {lore.nicknames.map((n) => (
          <p class="nick">Known as {n.names.map((x, i) => <>{i > 0 && ", "}<b>"{x}"</b></>)}. {n.text}</p>
        ))}
        <ol class="lore-list">
          {lore.moments.map((m) => (
            <li style={`--show:${m.show?.color ?? "var(--gold)"}`}>
              <a class="card" href={`/lore/#${m.id}`}>
                <span class="lore-when">{m.year}{m.show ? ` · ${seasonLabel(m.show, m.season)}` : ""}</span>
                <b>{m.title}</b>
                <span class="muted">{m.text}</span>
              </a>
            </li>
          ))}
          {lore.bonds.map((b) => (
            <li style="--show:var(--gold)">
              <a class="card" href="/lore/">
                <span class="lore-when">{b.kind} · with {others(b.people).join(", ")}</span>
                <b>{b.name}</b>
                <span class="muted">{b.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section>
      <div class="section-head"><h2>Survival record</h2></div>
      <ol class="timeline">
        {c.apps.map(({ show, season, entry }) => (
          <li>
            <a class="card" href={`/shows/${show.id}/#${season.id}`} style={`--show:${show.color}`}>
              <span>
                <b>{seasonLabel(show, season)}</b>
                <span class="when"> · {seasonNetwork(show, season)}, {season.aired}</span>
              </span>
              <span class:list={["res", { gold: entry.place === 1 }]}>{resultText(entry, season) || "Contestant"}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    {rivals.length > 0 && (
      <section>
        <div class="section-head"><h2>Old rivals</h2></div>
        <p class="muted" style="margin-top:-8px">Players who shared more than one season with {c.name}.</p>
        <div class="grid people">
          {rivals.map(([id, n]) => <PersonTile id={id} color={rivalColor(id)} sub={`${n} seasons together${headToHeadText(c.id, id) ? ` · ${headToHeadText(c.id, id)}` : ""}`} />)}
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .nick { margin: 0 0 10px; font-size: 15px; }
  .nick b { color: var(--gold); }
  .lore-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .lore-list .card { display: grid; gap: 4px; text-decoration: none; color: inherit; border-left: 3px solid var(--show); }
  .lore-list .muted { font-size: 14px; }
  .lore-when { font-size: 12px; font-weight: 700; color: var(--gold); letter-spacing: .02em; }
</style>
