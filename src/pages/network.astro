---
import Base from "../layouts/Base.astro";
import { shows, contestants, photos, seasonLabel, seasonYear, resultText } from "../lib/universe.mjs";

// Everything the explorer needs, built once at build time.
const graph = {
  shows: shows.map((s) => ({ id: s.id, name: s.name, color: s.color, network: s.network, years: s.years })),
  seasons: shows.flatMap((show) =>
    show.seasons.map((season) => ({
      id: season.id,
      show: show.id,
      name: season.title === show.name ? show.name : season.title,
      full: seasonLabel(show, season),
      aired: season.aired,
      year: seasonYear(season),
      upcoming: !!season.upcoming,
    }))
  ),
  people: contestants.map((c) => ({
    id: c.id,
    name: c.name,
    ko: c.ko ?? "",
    known: c.known ?? "",
    photo: photos[c.id]?.src ?? "",
    apps: c.apps.map(({ season, entry }) => ({ season: season.id, result: resultText(entry, season), won: entry.place === 1 })),
  })),
};
---
<Base title="Network" description="Explore who played with whom across every Korean survival show: search players, trace connections and filter by show.">
  <div class="net" id="net">
    <div class="net-canvas" id="graph" aria-label="3D network of players and the seasons they shared"></div>

    <div class="net-panel net-controls" id="controls">
      <div class="eyebrow">The network</div>
      <h1>Who played with whom</h1>

      <div class="search">
        <input id="find" type="search" placeholder="Find a player or show" aria-label="Find a player or show" autocomplete="off" />
        <ul class="suggest" id="find-list" role="listbox" hidden></ul>
      </div>

      <div class="active" id="active" hidden></div>

      <details class="more" id="more" open>
        <summary>Filters and tools</summary>

        <div class="label">View</div>
        <div class="seg" role="group" aria-label="View">
          <button type="button" data-view="players" aria-pressed="true">Players</button>
          <button type="button" data-view="seasons" aria-pressed="false">Seasons</button>
        </div>

        <div class="label">Who</div>
        <div class="seg" role="group" aria-label="Who to show">
          <button type="button" data-who="veterans" aria-pressed="true">Veterans</button>
          <button type="button" data-who="all" aria-pressed="false">Everyone</button>
        </div>

        <div class="label">Connect two players</div>
        <div class="connect">
          <div class="search">
            <input id="from" type="search" placeholder="From" aria-label="Connect from" autocomplete="off" />
            <ul class="suggest" id="from-list" role="listbox" hidden></ul>
          </div>
          <div class="search">
            <input id="to" type="search" placeholder="To" aria-label="Connect to" autocomplete="off" />
            <ul class="suggest" id="to-list" role="listbox" hidden></ul>
          </div>
          <button type="button" class="go" id="go">Find the connection</button>
        </div>

        <div class="label row">Shows <button type="button" class="link" id="all-shows">All</button></div>
        <div class="show-chips" id="show-chips">
          {shows.map((s) => (
            <button type="button" class="show-chip" data-show={s.id} aria-pressed="true" style={`--c:${s.color}`}>{s.name}</button>
          ))}
        </div>
        <p class="hint muted">Players take the color of the show they played most. Tap a show to hide it, double-tap to show only it. Gold lines join players who met on more than one show.</p>

        <label class="check"><input type="checkbox" id="flat" /> Flat view (2D)</label>
        <p class="hint muted">Drag to orbit, scroll or pinch to zoom. Hover a line to see what two players shared. Press / to search, Esc to clear.</p>
      </details>
    </div>

    <aside class="net-panel net-info" id="info" hidden aria-live="polite">
      <button type="button" class="close" id="close" aria-label="Close">×</button>
      <div id="info-body"></div>
    </aside>

    <div class="net-count" id="count" aria-live="polite"></div>
  </div>

  <script type="application/json" id="graph-data" set:html={JSON.stringify(graph)} />
  <script>
    import "../scripts/network.js";
  </script>
</Base>

<style>
  .net { position: relative; height: calc(100dvh - 61px); overflow: hidden; }
  .net-canvas { position: absolute; inset: 0; }
  :global(body:has(.net) .site-foot) { display: none; }

  .net-panel {
    position: absolute; z-index: 2;
    background: color-mix(in srgb, var(--card) 90%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line); border-radius: var(--radius);
    padding: 16px;
  }
  .net-controls { top: 16px; left: 16px; width: 300px; max-height: calc(100% - 32px); overflow: auto; }
  .net-controls h1 { font-size: 22px; margin: 6px 0 12px; }
  .label { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 14px 0 6px; }
  .label.row { display: flex; justify-content: space-between; align-items: center; }
  .seg { display: flex; background: var(--bg-2); border-radius: 10px; padding: 3px; }
  .seg button {
    flex: 1; font: 600 14px var(--sans); color: var(--muted); background: none;
    border: 0; border-radius: 8px; padding: 7px 8px; cursor: pointer;
    user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;
  }
  .seg button[aria-pressed="true"] { background: var(--card); color: var(--ink); box-shadow: 0 1px 3px rgb(0 0 0 / .25); }

  .search { position: relative; }
  .search input {
    width: 100%; font: inherit; font-size: 15px; color: var(--ink); background: var(--bg-2);
    border: 1px solid var(--line); border-radius: 10px; padding: 9px 11px;
  }
  .search input:focus { outline: 2px solid color-mix(in srgb, var(--accent) 60%, transparent); outline-offset: 0; }
  .suggest {
    position: absolute; z-index: 5; left: 0; right: 0; top: calc(100% + 4px);
    list-style: none; margin: 0; padding: 4px; max-height: 300px; overflow: auto;
    background: var(--card); border: 1px solid var(--line); border-radius: 10px;
    box-shadow: 0 10px 30px rgb(0 0 0 / .35);
  }
  :global(.suggest li) { display: flex; align-items: center; gap: 8px; padding: 7px 8px; border-radius: 7px; cursor: pointer; font-size: 14px; }
  :global(.suggest li[aria-selected="true"]), :global(.suggest li:hover) { background: var(--bg-2); }
  :global(.suggest .dot) { width: 9px; height: 9px; border-radius: 50%; flex: none; }
  :global(.suggest .meta) { margin-left: auto; color: var(--muted); font-size: 12px; text-align: right; }

  .active { margin-top: 10px; display: grid; gap: 6px; }
  :global(.active .tag) {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    font-size: 13px; padding: 6px 8px 6px 10px; border-radius: 8px;
    background: color-mix(in srgb, var(--gold) 16%, transparent); color: var(--ink);
  }
  :global(.active .tag button) { background: none; border: 0; color: var(--muted); font-size: 18px; line-height: 1; cursor: pointer; padding: 0 2px; }

  .more { margin-top: 12px; }
  .more summary { cursor: pointer; font-weight: 650; font-size: 14px; color: var(--muted); list-style: none; }
  .more summary::-webkit-details-marker { display: none; }
  .more summary::before { content: "▸ "; }
  .more[open] summary::before { content: "▾ "; }

  .connect { display: grid; gap: 6px; }
  .go, :global(.net-info .act) {
    font: 650 14px var(--sans); color: #fff; background: var(--accent);
    border: 0; border-radius: 9px; padding: 9px 12px; cursor: pointer;
    user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;
  }
  .link { background: none; border: 0; color: var(--accent); font: 600 12px var(--sans); cursor: pointer; text-transform: none; letter-spacing: 0; }
  .show-chips { display: flex; flex-wrap: wrap; gap: 5px; }
  .show-chip {
    font: 600 12px var(--sans); padding: 4px 9px 4px 7px; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--line); background: transparent; color: var(--muted);
    display: inline-flex; align-items: center; gap: 6px;
    user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;
  }
  .show-chip::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--c); opacity: .35; }
  .show-chip[aria-pressed="true"] { color: var(--ink); background: color-mix(in srgb, var(--c) 14%, transparent); border-color: color-mix(in srgb, var(--c) 45%, var(--line)); }
  .show-chip[aria-pressed="true"]::before { opacity: 1; }
  .check { display: flex; align-items: center; gap: 8px; margin-top: 14px; font-size: 14px; color: var(--muted); }
  .hint { font-size: 12px; margin: 8px 0 0; }

  .net-info { top: 16px; right: 16px; width: 340px; max-height: calc(100% - 32px); overflow: auto; }
  .close { position: absolute; top: 8px; right: 10px; background: none; border: 0; color: var(--muted); font-size: 26px; line-height: 1; cursor: pointer; }
  :global(.net-info h2) { font-size: 22px; margin: 4px 24px 2px 0; }
  :global(.net-info h3) { font-size: 13px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin: 16px 0 6px; font-family: var(--sans); }
  :global(.net-info .ko) { color: var(--muted); }
  :global(.net-info .pic) { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; object-position: 50% 25%; display: block; margin-bottom: 8px; }
  :global(.net-info .stat) { color: var(--muted); font-size: 14px; margin-top: 6px; }
  :global(.net-info .acts) { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  :global(.net-info .act.ghost) { background: var(--bg-2); color: var(--ink); }
  :global(.net-info a.act) { text-decoration: none; display: inline-block; }
  :global(.net-info ul) { list-style: none; padding: 0; margin: 0; display: grid; gap: 5px; }
  :global(.net-info .rec li) { display: flex; justify-content: space-between; gap: 10px; font-size: 13px; border-left: 3px solid var(--c); padding-left: 8px; }
  :global(.net-info .rec .r) { color: var(--muted); text-align: right; flex: none; max-width: 48%; }
  :global(.net-info .rec .r.won) { color: var(--gold); font-weight: 600; }
  :global(.net-info .mates) { display: flex; flex-wrap: wrap; gap: 5px; }
  :global(.net-info .mate) {
    font: 500 13px var(--sans); color: var(--ink); background: var(--bg-2); border: 1px solid var(--line);
    border-radius: 999px; padding: 4px 9px; cursor: pointer; display: inline-flex; gap: 5px; align-items: center;
  }
  :global(.net-info .mate b) { color: var(--gold); font-weight: 700; }
  :global(.net-info .mate.cross) { border-color: color-mix(in srgb, var(--gold) 50%, var(--line)); }
  :global(.net-info .hop) { display: grid; gap: 4px; padding: 8px 0; border-bottom: 1px dashed var(--line); }
  :global(.net-info .hop:last-child) { border-bottom: 0; }
  :global(.net-info .hop .who) { font-weight: 650; }
  :global(.net-info .chip) { margin: 0 4px 4px 0; }
  :global(.net-info .muted) { color: var(--muted); }

  .net-count { position: absolute; z-index: 1; left: 50%; bottom: 12px; transform: translateX(-50%); font-size: 12px; color: var(--muted); pointer-events: none; white-space: nowrap; }

  @media (max-width: 760px) {
    .net-controls { left: 8px; right: 8px; top: 8px; width: auto; padding: 12px; max-height: 60%; }
    .net-controls h1 { display: none; }
    .net-controls .eyebrow { display: none; }
    .net-info { left: 8px; right: 8px; top: auto; bottom: 8px; width: auto; max-height: 48%; }
    .net-count { bottom: auto; top: 4px; display: none; }
  }
</style>
